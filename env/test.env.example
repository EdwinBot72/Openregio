# ── OpenRegio — TEST-omgeving ──────────────────────────────────
# Kopieer naar env/test.env en vul in.  env/*.env staat in .gitignore.
# Deze waarden worden zowel door de app (env_file) als door compose
# (--env-file, voor de db-service) gebruikt.

# App
NODE_ENV=production
PORT=5000
APP_ENV=test

# Database (db-service draait in hetzelfde compose-netwerk, hostnaam = "db")
POSTGRES_USER=openregio
POSTGRES_PASSWORD=test-wachtwoord-wijzigen
POSTGRES_DB=openregio_test
DATABASE_URL=postgresql://openregio:test-wachtwoord-wijzigen@db:5432/openregio_test

# Auth — genereer met: openssl rand -hex 32
SESSION_SECRET=changeme-openssl-rand-hex-32

# Basis-URL (test kan een subdomein zijn)
PUBLIC_BASE_URL=https://test.openregio.nl
APP_BASE_URL=https://test.openregio.nl

# Optioneel — gebruik TEST-keys in Test
MOLLIE_API_KEY=
POSTMARK_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpenRegio Test <info@openregio.nl>
OPENAI_API_KEY=
AI_INTEGRATIONS_GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=
