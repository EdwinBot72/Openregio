# ── OpenRegio — ACCEPTATIE-omgeving ────────────────────────────
# Kopieer naar env/acceptatie.env en vul in.
# Acceptatie = zo dicht mogelijk bij productie, maar met test-keys
# waar echte transacties/mails ongewenst zijn.

NODE_ENV=production
PORT=5000
APP_ENV=acceptatie

POSTGRES_USER=openregio
POSTGRES_PASSWORD=acc-wachtwoord-wijzigen
POSTGRES_DB=openregio_acc
DATABASE_URL=postgresql://openregio:acc-wachtwoord-wijzigen@db:5432/openregio_acc

# Genereer met: openssl rand -hex 32  (eigen secret, NIET delen met test/prod)
SESSION_SECRET=changeme-openssl-rand-hex-32

PUBLIC_BASE_URL=https://acceptatie.openregio.nl
APP_BASE_URL=https://acceptatie.openregio.nl

# Optioneel — meestal test-keys, maar productie-achtige config
MOLLIE_API_KEY=
POSTMARK_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpenRegio Acceptatie <info@openregio.nl>
OPENAI_API_KEY=
AI_INTEGRATIONS_GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=
