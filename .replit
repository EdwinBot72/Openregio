modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["unzip"]

[deployment]
deploymentTarget = "vm"
build = ["npm", "run", "build"]
run = ["bash", "-c", "NODE_ENV=production node dist/index.js"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 4200

[[ports]]
localPort = 5904
externalPort = 3000

[[ports]]
localPort = 23636
externalPort = 3002

[[ports]]
localPort = 23637
externalPort = 3001

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
integrations = ["javascript_openai_ai_integrations:1.0.0", "javascript_mem_db:1.0.0", "javascript_stripe:1.0.0", "javascript_log_in_with_replit:1.0.0", "javascript_object_storage:2.0.0", "javascript_gemini_ai_integrations:2.0.0"]

[userenv]

[userenv.shared]
PUBLIC_BASE_URL = "https://www.openregio.nl"
APP_BASE_URL = "https://open-regio.replit.app"
SMTP_HOST = "mail.mijndomein.nl"
SMTP_PORT = "587"
SMTP_USER = "info@openregio.nl"
SMTP_FROM = "OpenRegio <info@openregio.nl>"
VITE_MOLLIE_BASIC_PAYMENT_LINK = "https://payment-links.mollie.com/payment/FNnWr8uofpfEd6PJQMWHk"
VITE_MOLLIE_PRO_PAYMENT_LINK = "https://payment-links.mollie.com/payment/nEdtEni7GkJG7rHHetyBs"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
