# ═══════════════════════════════════════════════════════════════
# OpenRegio — Environment Contract
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env (local dev) or set these in Replit Secrets.
# Variables marked [REQUIRED] will cause the server to refuse to boot.
# Variables marked [OPTIONAL] disable specific features when absent.
# ═══════════════════════════════════════════════════════════════


# ── 1. RUNTIME ──────────────────────────────────────────────────

NODE_ENV=production                                         # [OPTIONAL — defaults to "development"]
PORT=3000                                                   # [OPTIONAL — defaults to 5000]


# ── 2. BOOT — required to start the server ──────────────────────

# PostgreSQL connection string (provided automatically by Replit DB)
DATABASE_URL=postgresql://user:password@host:5432/dbname   # [REQUIRED]

# Secret used to sign JWT access tokens — generate with: openssl rand -hex 32
SESSION_SECRET=changeme-use-openssl-rand-hex-32             # [REQUIRED]

# Auth: JWT access tokens expire after 15 minutes; refresh tokens last 7 days.
# Cookie flags: httpOnly=true, secure=true (production), sameSite=strict.


# ── 3. PAYMENTS — Mollie ────────────────────────────────────────
# Without this key, /start and /api/mollie/webhook return 503.
# Use a test key (test_...) for staging, live key (live_...) for production.
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx        # [OPTIONAL — payments disabled without this]

# Base URL used for Mollie webhook callbacks and redirect URLs.
# Must be publicly reachable (not localhost) when Mollie webhooks are live.
# Falls back to the request Host header in development.
APP_BASE_URL=https://www.openregio.nl                      # [OPTIONAL — recommended for production]
PUBLIC_BASE_URL=https://www.openregio.nl                   # [OPTIONAL — alias for APP_BASE_URL]

# Mollie-specifieke overrides (optioneel — worden afgeleid van PUBLIC_BASE_URL als niet ingesteld)
MOLLIE_WEBHOOK_URL=                                        # [OPTIONAL — default: PUBLIC_BASE_URL/api/mollie/webhook]
MOLLIE_REDIRECT_URL=                                       # [OPTIONAL — default: PUBLIC_BASE_URL/betaling-geslaagd]


# ── 4. EMAIL ────────────────────────────────────────────────────
# Optie A: Postmark (transactionele e-mail via API)
POSTMARK_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx      # [OPTIONAL — email disabled without this]

# Optie B: SMTP (bijv. mail.mijndomein.nl)
SMTP_HOST=mail.mijndomein.nl                               # [OPTIONAL — SMTP host]
SMTP_PORT=587                                              # [OPTIONAL — 587 (STARTTLS) of 465 (SSL)]
SMTP_USER=info@openregio.nl                                # [OPTIONAL — SMTP gebruikersnaam]
SMTP_PASS=jouw-smtp-wachtwoord                             # [OPTIONAL — SMTP wachtwoord]
SMTP_FROM=OpenRegio <info@openregio.nl>                    # [OPTIONAL — afzendernaam + adres]


# ── 5. AI / INTEGRATIONS ────────────────────────────────────────
# OpenAI key — used by RegioBot (RAG), Brief Analyse, and other AI features.
# Falls back to AI_INTEGRATIONS_OPENAI_API_KEY if set (Replit-managed key).
OPENAI_API_KEY=sk-...                                       # [OPTIONAL — AI features disabled without this]
OPENAI_BASE_URL=https://api.openai.com/v1                  # [OPTIONAL — override for proxy/Azure]

# Replit-managed AI keys (set automatically when Replit AI integration is active)
AI_INTEGRATIONS_OPENAI_API_KEY=                            # [OPTIONAL — auto-set by Replit]
AI_INTEGRATIONS_OPENAI_BASE_URL=                           # [OPTIONAL — auto-set by Replit]
AI_INTEGRATIONS_GEMINI_API_KEY=                            # [OPTIONAL — used by Kansen-radar en Buurman]
AI_INTEGRATIONS_GEMINI_BASE_URL=                           # [OPTIONAL — auto-set by Replit]

# Google Places API — locatie-autocomplete
GOOGLE_PLACES_API_KEY=                                     # [OPTIONAL — autocomplete disabled without this]


# ── 6. OBJECT STORAGE ───────────────────────────────────────────
# Set automatically by Replit Object Storage integration.
PRIVATE_OBJECT_DIR=.private                                # [OPTIONAL — auto-set by Replit]
PUBLIC_OBJECT_SEARCH_PATHS=public                          # [OPTIONAL — auto-set by Replit]


# ── 7. EXTERNE SERVICES ─────────────────────────────────────────
# Externe upload-server voor Brief Analyse "opslaan-extern" functie.
# Als niet ingesteld: endpoint geeft 503 "niet geconfigureerd" terug.
BACKEND_UPLOAD_URL=                                        # [OPTIONAL — opslaan-extern disabled without this]


# ── SUMMARY ─────────────────────────────────────────────────────
#
# Required to boot:
#   DATABASE_URL, SESSION_SECRET
#
# Required for payments:
#   MOLLIE_API_KEY, PUBLIC_BASE_URL (for webhook callbacks)
#
# Required for email:
#   POSTMARK_API_KEY
#
# Required for AI features:
#   OPENAI_API_KEY  (or AI_INTEGRATIONS_OPENAI_API_KEY)
#   AI_INTEGRATIONS_GEMINI_API_KEY  (for Kansen-radar, Buurman)
#
# Required for extern opslaan (Brief Analyse):
#   BACKEND_UPLOAD_URL
# ═══════════════════════════════════════════════════════════════
