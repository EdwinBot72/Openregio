# ── OpenRegio — PRODUCTIE-omgeving ─────────────────────────────
# Kopieer naar env/productie.env en vul in met ECHTE, LIVE waarden.
# Bewaar dit bestand nooit in git en deel het niet. Beheer geheimen
# bij voorkeur via een secret-manager of GitHub Environment-secrets.

NODE_ENV=production
PORT=5000
APP_ENV=productie

POSTGRES_USER=openregio
POSTGRES_PASSWORD=STERK-UNIEK-WACHTWOORD
POSTGRES_DB=openregio_prod
DATABASE_URL=postgresql://openregio:STERK-UNIEK-WACHTWOORD@db:5432/openregio_prod

# Genereer met: openssl rand -hex 32  (uniek, nooit hergebruiken)
SESSION_SECRET=zet-hier-een-echte-random-hex-32

PUBLIC_BASE_URL=https://www.openregio.nl
APP_BASE_URL=https://www.openregio.nl

# LIVE keys
MOLLIE_API_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTMARK_API_KEY=
SMTP_HOST=mail.mijndomein.nl
SMTP_PORT=587
SMTP_USER=info@openregio.nl
SMTP_PASS=
SMTP_FROM=OpenRegio <info@openregio.nl>
OPENAI_API_KEY=
AI_INTEGRATIONS_GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=
